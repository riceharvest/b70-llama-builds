#!/usr/bin/env bash
# Entry point of ghcr.io/riceharvest/b70-llama. https://github.com/riceharvest/b70-llama-builds
set -euo pipefail
L=${B70_LLAMA_DIR:-/opt/llama}
M=${B70_MODELS_DIR:-/models}
BOLT_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-GGUF
BOLT_GGUF=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf
BOLT_MMPROJ=mmproj-NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf
BOLT_DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr-GGUF
BOLT_DRAFT=NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr.gguf
BOLT_OURS=${BOLT_OURS_REPO:-darioooooo0o/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-GGUF}
usage() {
  cat <<'U'
b70-llama: llama.cpp for the Intel Arc Pro B70 (SYCL + Vulkan in one image)

  docker run --rm -it --device /dev/dri -v ~/models:/models -p 8080:8080 ghcr.io/riceharvest/b70-llama <command>

commands:
  vulkan <llama-server args>   serve with the Vulkan build (Mesa 26 in the image); --host 0.0.0.0 --port 8080 -ngl 99 are added
  sycl   <llama-server args>   serve with the SYCL build (AOT for the B70, oneAPI runtime bundled)
  bench  sycl|vulkan <llama-bench args>
  bolt   [--quant Q4_K_M|IQ4_XS|...] [--no-draft] [--no-vision] [llama-server args]
                               NVIDIA Nemotron 3.5 Bolt 74B-A9B (24 GB GGUF + vision + LiLiCorr drafter) on Vulkan:
                               downloads it into /models/bolt on first use (~22 GB), then serves on :8080.
                               --quant <type>: a 3- to 8-bit file from the BF16 weights instead (larger than VRAM: llama.cpp's
                               --fit keeps part of the experts in system RAM). BOLT_MODEL=/models/<x>.gguf: any other file
  get    <hf-repo> <file> [name]  download a GGUF from Hugging Face into /models[/name] (resumes)
  run    sycl|vulkan <binary> <args>   any binary of a build, e.g. llama-cli
  info                         versions and the GPUs each backend sees
U
}
need_dri() { [ -e /dev/dri ] || [ "${B70_SKIP_DRI_CHECK:-0}" = 1 ] || { echo "no /dev/dri in the container: add --device /dev/dri" >&2; exit 2; }; }
bin() { # backend name
  case "$1" in sycl|vulkan) [ -x "$L/$1/$2" ] || { echo "no $2 in the $1 build" >&2; exit 2; }; echo "$L/$1/$2" ;;
    *) echo "backend must be sycl or vulkan, got '$1'" >&2; exit 2 ;; esac
}
has_arg() { local a=$1; shift; for x in "$@"; do [ "$x" = "$a" ] && return 0; done; return 1; }
# pick_dev BIN: with more than one GPU visible (e.g. an Intel iGPU next to the B70), print the Battlemage one (else the
# largest); nothing when there is only one
pick_dev() {
  "$1" --list-devices 2>/dev/null | awk '
    match($0, /^ +([^ :]+): (.*) \(([0-9]+) MiB, [0-9]+ MiB free\)/, m) {
      n++; bmg = (m[2] ~ /Arc\(TM\) (Pro )?B[0-9]+|Battlemage|BMG|B70/) ? 1 : 0
      if (!best || bmg > bb || (bmg == bb && m[3] + 0 > bm)) { best = m[1]; bb = bmg; bm = m[3] + 0; bd = m[2] }
    }
    END { if (n > 1) print best "\t" bd "\t" n }'
}
dev_args() { # BIN ARGS... -> prints "-dev NAME" (and a note on stderr) unless the user chose a device
  local b=$1; shift
  has_arg -dev "$@" || has_arg --device "$@" || [ "${B70_NO_DEVICE_PICK:-0}" = 1 ] && return 0
  local p; p=$(pick_dev "$b") || true
  [ -n "$p" ] || return 0
  IFS=$'\t' read -r name desc n <<< "$p"
  echo "b70-llama: $n GPUs visible, using $name ($desc); pass -dev to choose another" >&2
  printf '%s\n' -dev "$name"
}
cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  vulkan|sycl)
    need_dri; b=$(bin "$cmd" llama-server); extra=()
    has_arg --host "$@" || extra+=(--host 0.0.0.0)
    has_arg --port "$@" || extra+=(--port 8080)
    has_arg -ngl "$@" || has_arg --n-gpu-layers "$@" || extra+=(-ngl 99)
    mapfile -t dv < <(dev_args "$b" "$@"); extra+=("${dv[@]}")
    exec "$b" "${extra[@]}" "$@" ;;
  bench) need_dri; b=$(bin "${1:-}" llama-bench); shift
    mapfile -t dv < <(dev_args "$b" "$@"); exec "$b" "${dv[@]}" "$@" ;;
  run) need_dri; b=$(bin "${1:-}" "${2:-}"); shift 2; exec "$b" "$@" ;;
  get)
    repo=${1:?usage: get <hf-repo> <file> [name]}; file=${2:?usage: get <hf-repo> <file> [name]}; name=${3:-$(basename "$file")}
    case "$repo$file$name" in *..*|*[!A-Za-z0-9._/-]*) echo "unexpected repo or file name" >&2; exit 2 ;; esac
    out=$M/$(basename "$name")
    echo "downloading $repo/$file -> $out"
    curl -fL -C - --retry 5 ${HF_TOKEN:+-H "Authorization: Bearer $HF_TOKEN"} -o "$out.part" "https://huggingface.co/$repo/resolve/main/$file"
    mv "$out.part" "$out"; echo "done: $out" ;;
  bolt)
    need_dri; b=$(bin vulkan llama-server); draft=1; vision=1; quant=""; args=()
    while [ $# -gt 0 ]; do case "$1" in
      --no-draft) draft=0 ;; --no-vision) vision=0 ;;
      --quant) quant=${2:?--quant needs a type, e.g. IQ4_XS}; shift ;;
      *) args+=("$1") ;; esac; shift; done
    case "$quant" in *[!A-Za-z0-9_]*) echo "bad --quant: $quant" >&2; exit 2 ;; esac
    d=$M/bolt; mkdir -p "$d"
    fetch() { [ -s "$d/$2" ] || B70_MODELS_DIR=$d "$0" get "$1" "$2" >&2; }
    model=${BOLT_MODEL:-}; ngl=(-ngl 99)
    if [ -z "$model" ] && [ -n "$quant" ]; then
      # single file at the repo root, or llama-gguf-split parts in a folder named after the type
      listing=$(curl -fsSL ${HF_TOKEN:+-H "Authorization: Bearer $HF_TOKEN"} "https://huggingface.co/api/models/$BOLT_OURS" \
                | grep -oE '"rfilename": *"[^"]+\.gguf"' | sed -E 's/.*"([^"]+)"$/\1/') || true
      files=$(echo "$listing" | grep -E "^($quant/[^/]+|[^/]+-$quant)\.gguf$" | grep -v '^mmproj-' | sort) || true
      [ -n "$files" ] || { echo "no $quant file in $BOLT_OURS (yet?)" >&2; exit 2; }
      for f in $files; do
        sub=$(dirname "$f"); [ "$sub" = . ] && sub= || mkdir -p "$d/$sub"
        [ -s "$d/$f" ] || B70_MODELS_DIR=$d${sub:+/$sub} "$0" get "$BOLT_OURS" "$f" >&2
      done
      model=$d/$(echo "$files" | head -1); ngl=()   # bigger than VRAM: let --fit choose the GPU / RAM split
      ours_mmproj=$(echo "$listing" | grep -E '^mmproj-.*-Q8_0\.gguf$' | head -1) || true
    elif [ -z "$model" ]; then fetch $BOLT_REPO $BOLT_GGUF; model=$d/$BOLT_GGUF; fi
    extra=(--host 0.0.0.0 --port 8080 "${ngl[@]}" -fa on -c 32768 -np 1 --jinja --temp 1.0 --top-p 0.95 -m "$model")
    if [ $vision = 1 ]; then
      # the vision encoder (1.7 GB) stays on the CPU: images take ~5 s, and the VRAM goes to context + the drafter
      if [ -n "${ours_mmproj:-}" ]; then fetch "$BOLT_OURS" "$ours_mmproj"; mm=$d/$ours_mmproj   # same BF16 weights as --quant
      else fetch $BOLT_REPO $BOLT_MMPROJ; mm=$d/$BOLT_MMPROJ; fi
      extra+=(--mmproj "$mm" --no-mmproj-offload)
    fi
    if [ $draft = 1 ]; then
      # LiLiCorr speculative decoding: +27% on code on a B70 (Mesa 26), no gain on prose; --no-draft saves ~1 GB VRAM
      fetch $BOLT_DRAFT_REPO $BOLT_DRAFT
      extra+=(--spec-type draft-dflash --spec-draft-model "$d/$BOLT_DRAFT" --spec-draft-ngl 99 --spec-draft-n-max 6)
    fi
    mapfile -t dv < <(dev_args "$b" "${args[@]}"); extra+=("${dv[@]}")
    exec "$b" "${extra[@]}" "${args[@]}" ;;
  info)
    echo "release: $(cat $L/RELEASE)"
    pacman -Q vulkan-intel intel-compute-runtime level-zero-loader 2>/dev/null | sed 's/^/package: /'
    if [ -e /dev/dri ]; then
      echo "Vulkan devices:"; "$L/vulkan/llama-bench" --list-devices 2>/dev/null | sed -n '2,$p' || true
      echo "SYCL devices:";   "$L/sycl/llama-bench" --list-devices 2>/dev/null | sed -n '2,$p' || true
    else echo "(no /dev/dri: start with --device /dev/dri to list GPUs)"; fi ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
