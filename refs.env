# Pinned sources. Change a line and push to main to publish a new release.
# SYCL: upstream master a0e6dc738 + B70 SYCL fixes (fork branch sycl-b70-release): qwen35moe decode fusions (on by default),
# fused MoE GEMV for 2-8 token batches (MTP verify), flash-attention KV split sized from Xe2 occupancy, GQA padding in the
# tile FA kernel (GQA 6 models such as Qwen3.8-27B), oneDNN gemm only on 64-byte aligned buffers.
SYCL_REPO=https://github.com/riceharvest/llama.cpp
SYCL_REF=56cb978b7428a5bbcbb4f3993503eb8fe4aa3550
# Vulkan: upstream master + the B70 decode/prefill fixes (fork branch vk-b70-stack).
VULKAN_REPO=https://github.com/riceharvest/llama.cpp
VULKAN_REF=54b6e8485d74e85a1943ccd549a7c1669354166a
# Toolchains
ONEAPI_VERSION=2025.3
VULKAN_SDK_VERSION=1.4.363.0
COMPUTE_RUNTIME_TAG=26.27.39122.11
LEVEL_ZERO_VERSION=1.34.0
IGC_TAG=v2.38.2
